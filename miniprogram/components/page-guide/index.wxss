.page-guide {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 20rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 107, 26, 0.28);
  border-radius: 16rpx;
  background: rgba(255, 107, 26, 0.08);
}

.guide-icon {
  width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  margin-top: 2rpx;
  text-align: center;
  color: #141414;
  background: #FF7A2A;
  border-radius: 50%;
  font-size: 19rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.guide-copy { flex: 1; min-width: 0; }
.guide-title { color: #F4F4F4; font-size: 23rpx; font-weight: 700; }
.guide-content { margin-top: 5rpx; color: #A5A5A5; font-size: 21rpx; line-height: 1.45; }
.guide-dismiss { padding: 5rpx 0 5rpx 10rpx; color: #FF9A58; font-size: 21rpx; white-space: nowrap; flex-shrink: 0; }
