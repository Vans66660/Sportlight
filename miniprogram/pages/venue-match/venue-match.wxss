page {
  background: #0F0F0F;
}

.container {
  height: 100vh;
  background: #0F0F0F;
  position: relative;
}

.loading-wrap {
  color: #777777;
  text-align: center;
  padding-top: 180rpx;
}

.page-scroll {
  height: 100vh;
}

.hero {
  height: 520rpx;
  position: relative;
  overflow: hidden;
  background: #151515;
}

.hero-image {
  width: 100%;
  height: 520rpx;
  background: #1A1A1A;
}

.hero-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #777777;
  font-size: 28rpx;
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 300rpx;
  background: linear-gradient(180deg, rgba(15, 15, 15, 0), rgba(15, 15, 15, 0.96));
}

.hero-content {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 34rpx;
}

.venue-name {
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.venue-address {
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  line-height: 1.45;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.tag {
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.13);
  color: #FFFFFF;
  font-size: 22rpx;
}

.content {
  padding: 24rpx 28rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.info-card {
  min-height: 112rpx;
  border-radius: 18rpx;
  background: #1A1A1A;
  border: 1rpx solid #282828;
  padding: 18rpx 12rpx;
  box-sizing: border-box;
  text-align: center;
}

.info-value {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 900;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-label {
  color: #777777;
  font-size: 21rpx;
}

.section {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #1A1A1A;
  border: 1rpx solid #282828;
}

.section-title {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 900;
  margin-bottom: 16rpx;
}

.location-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(255, 107, 26, 0.14), rgba(61, 187, 138, 0.1));
  border: 1rpx solid rgba(255, 107, 26, 0.24);
}

.location-pin {
  width: 58rpx;
  height: 58rpx;
  border-radius: 16rpx;
  background: rgba(255, 107, 26, 0.18);
  color: #FFB36A;
  font-size: 34rpx;
  line-height: 58rpx;
  text-align: center;
  flex-shrink: 0;
}

.location-main {
  flex: 1;
  min-width: 0;
}

.location-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.location-name {
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 800;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-address {
  color: #AAAAAA;
  font-size: 22rpx;
  line-height: 1.45;
}

.location-action {
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 24rpx;
  background: #FF6B1A;
  color: #FFFFFF;
  font-size: 22rpx;
  flex-shrink: 0;
}

.location-action.ghost {
  color: #FFB36A;
  background: rgba(255, 107, 26, 0.14);
}

.gallery-scroll {
  white-space: nowrap;
}

.gallery-image {
  width: 220rpx;
  height: 150rpx;
  border-radius: 16rpx;
  background: #111111;
  margin-right: 12rpx;
}

.court-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #282828;
}

.court-row:last-child {
  border-bottom: 0;
}

.court-name {
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 800;
  margin-bottom: 6rpx;
}

.court-sub {
  color: #777777;
  font-size: 22rpx;
}

.price-box {
  color: #FFB36A;
  font-size: 22rpx;
  line-height: 1.55;
  text-align: right;
  flex-shrink: 0;
}

.description {
  color: #B6B6B6;
  font-size: 24rpx;
  line-height: 1.7;
}

.empty-line {
  color: #777777;
  font-size: 24rpx;
  text-align: center;
  padding: 26rpx 0;
}

.bottom-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(15, 15, 15, 0.94);
  border-top: 1rpx solid #242424;
  box-sizing: border-box;
  display: flex;
  gap: 14rpx;
}

.booking-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 22rpx;
  background: #FF6B1A;
  color: #FFFFFF;
  text-align: center;
  font-size: 30rpx;
  font-weight: 900;
}

.booking-btn.secondary {
  background: #252525;
  color: #FFB36A;
}
