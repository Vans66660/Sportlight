.legal-page {
  min-height: 100vh;
  background: #0F0F0F;
  color: #EDEDED;
  padding: 44rpx 32rpx 72rpx;
  box-sizing: border-box;
}

.legal-block {
  font-size: 28rpx;
  line-height: 1.78;
  color: #CFCFCF;
  margin-bottom: 22rpx;
  word-break: break-word;
}

.legal-title {
  font-size: 40rpx;
  line-height: 1.28;
  color: #FFFFFF;
  font-weight: 800;
  margin-bottom: 18rpx;
}

.legal-meta {
  color: #888888;
  font-size: 24rpx;
  margin-bottom: 36rpx;
}

.legal-notice-title {
  color: #FFB36A;
  font-size: 30rpx;
  font-weight: 800;
  margin-top: 20rpx;
}

.legal-heading {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 800;
  margin-top: 42rpx;
  margin-bottom: 18rpx;
}

.legal-subheading {
  color: #F3F3F3;
  font-size: 28rpx;
  font-weight: 700;
  margin-top: 26rpx;
  margin-bottom: 12rpx;
}

.legal-bullet {
  padding-left: 22rpx;
  color: #D8D8D8;
}

.legal-action-spacer {
  height: 156rpx;
}

.legal-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 48rpx calc(22rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(15, 15, 15, 0.82), #0F0F0F 28%);
  border-top: 1rpx solid #242424;
  box-sizing: border-box;
}

.legal-agree-btn {
  width: 100%;
  height: 92rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 32rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
  color: #FFFFFF;
}

.legal-agree-btn.enabled {
  background: #FF6B1A;
  box-shadow: 0 10rpx 28rpx rgba(255, 107, 26, 0.26);
}

.legal-agree-btn.disabled {
  background: #2B2B2B;
  color: #8F8F8F;
}
