@import "../venue-manage/venue-manage.wxss";

.detail-container {
  padding-top: 24rpx;
}

.detail-header {
  margin-bottom: 20rpx;
}

.detail-title {
  color: #FFFFFF;
  font-size: 42rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.detail-sub {
  color: #777777;
  font-size: 24rpx;
}

.settlement-rule-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.035);
  border: 1rpx solid rgba(255,255,255,0.06);
}

.settlement-rule-title {
  color: #D6D6D6;
  font-size: 26rpx;
  font-weight: 800;
}

.settlement-rule-desc {
  color: #686868;
  font-size: 22rpx;
  margin-top: 6rpx;
}

.settlement-rule-rate {
  flex-shrink: 0;
  color: #8A8A8A;
  font-size: 28rpx;
  font-weight: 800;
}

.empty-action {
  margin-top: 14rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 107, 26, 0.45);
  border-radius: 14rpx;
  color: #FF8C47;
  font-size: 23rpx;
}
