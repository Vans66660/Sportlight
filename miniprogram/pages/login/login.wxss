.container {
  min-height: 100vh;
  background-color: #0F0F0F;
  padding: 120rpx 40rpx 46rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* ===== Logo ===== */
.logo-wrap {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo-text {
  font-size: 72rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 0;
}

.logo-dot {
  display: inline-block;
  color: #FF6B1A;
  font-weight: 700;
  font-size: 44rpx;
  line-height: 1;
  margin: 0 4rpx;
  transform: translateY(-4rpx);
}

.logo-divider {
  width: 360rpx;
  height: 6rpx;
  background-color: #FF6B1A;
  border-radius: 999rpx;
  margin: 18rpx auto 16rpx;
  opacity: 0.92;
}

.logo-sub {
  font-size: 30rpx;
  color: #E8E8E8;
  font-weight: 600;
  letter-spacing: 0;
  margin-top: 24rpx;
}

.logo-img {
  width: 420rpx;
  height: 420rpx;
  display: block;
  margin: 48rpx auto 0;
}

.logo-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #777777;
  line-height: 1.5;
}

.value-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-bottom: 44rpx;
}

.value-card {
  background: #171717;
  border: 1rpx solid #242424;
  border-radius: 16rpx;
  padding: 22rpx 18rpx;
}

.value-title {
  color: #FFB36A;
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.value-desc {
  color: #888888;
  font-size: 22rpx;
  line-height: 1.45;
}

/* ===== 微信一键登录按钮 ===== */
.wechat-login-btn {
  width: 76%;
  margin: 0 auto;
  background: #171717;
  border: 0;
  border-radius: 20rpx;
  padding: 28rpx 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  margin-bottom: 18rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255, 107, 26, 0.46), 0 16rpx 32rpx rgba(0, 0, 0, 0.24);
  box-sizing: border-box;
  overflow: hidden;
  position: relative;
}

.wechat-login-btn::after {
  border: 0;
}

.wechat-login-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-hover-dark {
  background: #222 !important;
  box-shadow: inset 0 0 0 1rpx rgba(255, 107, 26, 0.6), 0 16rpx 32rpx rgba(0, 0, 0, 0.3) !important;
}

.wechat-login-btn--inactive {
  opacity: 0.64;
}

.wechat-mark-img {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
}

.wechat-main {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.25;
  text-align: center;
  white-space: nowrap;
}

.wechat-arrow {
  color: #FF6B1A;
  font-size: 44rpx;
  line-height: 1;
  flex-shrink: 0;
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
}

.wechat-hint {
  text-align: center;
  font-size: 23rpx;
  color: #777777;
  margin-bottom: 34rpx;
}

/* ===== 登录成功：简洁过渡 ===== */
.login-success-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.success-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #FF6B1A;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.success-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.success-name {
  font-size: 26rpx;
  color: #FF6B1A;
  margin-top: 10rpx;
}

/* ===== 一键注册入口 ===== */
.register-hint {
  text-align: center;
  font-size: 28rpx;
  color: #888888;
  margin-bottom: 48rpx;
  padding: 16rpx;
}

.identity-icon-venue {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #333333;
}

.identity-pic-boss {
  width: 62rpx;
  height: 62rpx;
  margin: 0;
}

.identity-pic-venue {
  width: 60rpx;
  height: 60rpx;
  filter: brightness(0) invert(1);
}

/* ===== 分割线 ===== */
.divider-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background-color: #1E1E1E;
}

.divider-text {
  font-size: 22rpx;
  color: #444444;
  flex-shrink: 0;
}

/* ===== 身份选择区 ===== */
.identity-section {
  /* anchor target */
}

.section-label {
  font-size: 24rpx;
  color: #555555;
  text-align: center;
  margin-bottom: 24rpx;
}

.identity-wrap {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.identity-btn {
  background-color: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 28rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
  transition: all 0.2s;
}

.identity-btn.active {
  border-color: #FF6B1A;
  background-color: rgba(255, 107, 26, 0.04);
}

.identity-icon {
  width: 100rpx;
  height: 100rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.identity-icon-athlete {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #333333;
}

.identity-pic {
  width: 100%;
  height: 100%;
  flex-shrink: 0;
}

.identity-pic-athlete {
  width: 62rpx;
  height: 62rpx;
  filter: brightness(0) invert(1);
}

.identity-icon-boss {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #333333;
}

.identity-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #FF6B1A;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.identity-info { flex: 1; min-width: 0; }

.identity-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 6rpx;
}

.identity-desc {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.4;
}

/* ===== 继续/跳过按钮 ===== */
.btn-continue {
  width: 100%;
  box-sizing: border-box;
  border-radius: 24rpx;
  padding: 32rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  margin-bottom: 32rpx;
}

.btn-active {
  background-color: #FF6B1A;
  color: #FFFFFF;
}

.btn-disabled {
  background-color: #1A1A1A;
  color: #444444;
}

.btn-skip {
  text-align: center;
  font-size: 26rpx;
  color: #AAAAAA;
  padding: 18rpx;
}

.skip-wrap {
  margin-bottom: 28rpx;
}

/* ===== 底部协议 ===== */
.terms {
  text-align: left;
  font-size: 22rpx;
  color: #555555;
  line-height: 1.6;
}

.terms-check {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 12rpx;
}

.terms-checkbox {
  width: 28rpx;
  height: 28rpx;
  margin-top: 4rpx;
  border: 2rpx solid #555555;
  border-radius: 6rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0F0F0F;
  font-size: 20rpx;
  font-weight: 800;
  flex: 0 0 28rpx;
}

.terms-checkbox.checked {
  background: #FF6B1A;
  border-color: #FF6B1A;
}

.terms-copy {
  max-width: 560rpx;
}

.terms-link { color: #FF6B1A; }

.brand-slogan {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 96rpx;
  color: #666666;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 0;
}

.brand-slogan-dot {
  color: #FF6B1A;
  font-size: 26rpx;
  font-weight: 800;
}

/* ===== 返回登录 ===== */
.back-to-login {
  text-align: center;
  font-size: 26rpx;
  color: #888888;
  margin-top: 32rpx;
  padding: 16rpx;
}
