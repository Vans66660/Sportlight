page { background: #0F0F0F; }
.page { min-height: 100vh; padding: 28rpx; box-sizing: border-box; color: #FFFFFF; padding-bottom: calc(130rpx + env(safe-area-inset-bottom)); }
.team-card, .venue { background: #1A1A1A; border: 1rpx solid #2A2A2A; border-radius: 16rpx; padding: 18rpx; display: flex; align-items: center; gap: 16rpx; margin-bottom: 14rpx; }
.logo { width: 72rpx; height: 72rpx; border-radius: 50%; background: #242424; flex-shrink: 0; }
.logo.text { display: flex; align-items: center; justify-content: center; color: #FF6B1A; font-weight: 800; }
.main { flex: 1; min-width: 0; }
.name, .venue-name { font-size: 29rpx; font-weight: 800; }
.meta, .venue-address { color: #777777; font-size: 23rpx; margin-top: 6rpx; }
.label { color: #888888; font-size: 24rpx; margin: 26rpx 0 12rpx; }
.seg-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.seg, .picker, .textarea { background: #1A1A1A; border: 1rpx solid #2A2A2A; border-radius: 12rpx; color: #FFFFFF; font-size: 26rpx; box-sizing: border-box; }
.seg { padding: 16rpx 24rpx; color: #888888; }
.seg.active { background: #FF6B1A; border-color: #FF6B1A; color: #FFFFFF; font-weight: 800; }
.picker { height: 82rpx; line-height: 82rpx; padding: 0 20rpx; }
.venue.selected { border-color: #FF6B1A; background: rgba(255,107,26,.1); }
.venue > view:first-child { flex: 1; min-width: 0; }
.check { width: 44rpx; color: #FF6B1A; text-align: center; font-size: 34rpx; }
.textarea { width: 100%; min-height: 180rpx; padding: 20rpx; }
.submit { position: fixed; left: 28rpx; right: 28rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 14rpx; background: #FF6B1A; font-size: 30rpx; font-weight: 900; }
