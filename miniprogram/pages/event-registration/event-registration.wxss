.page { min-height: 100vh; background:#0f0f0f; color:#f4f4f4; padding:28rpx 32rpx 72rpx; box-sizing:border-box; }
.state,.empty { color:#858585; text-align:center; padding:160rpx 24rpx; font-size:30rpx; }
.event-summary { padding:28rpx; background:#1b1b1b; border:1rpx solid #2a2a2a; border-radius:12rpx; display:flex; flex-direction:column; gap:12rpx; }
.event-label,.event-meta,.choice-desc,.team-meta,.payment-note,.roster-note { color:#8e8e8e; font-size:26rpx; line-height:1.55; }
.event-title { font-size:38rpx; font-weight:700; }
.content { margin-top:42rpx; }
.section-title { font-size:42rpx; font-weight:700; display:block; margin-bottom:24rpx; }
.choice-card,.team-row,.member-row { background:#1b1b1b; border:1rpx solid #2a2a2a; border-radius:12rpx; padding:28rpx; margin-bottom:20rpx; box-sizing:border-box; }
.choice-main { border-color:#a94c1f; background:#231914; }
.choice-title,.team-name { display:block; font-size:34rpx; font-weight:650; margin-bottom:10rpx; }
.captain-link-hint { display:block; color:#b7b7b7; font-size:25rpx; line-height:1.55; margin:4rpx 8rpx 18rpx; }
.payment-note { display:block; margin:28rpx 8rpx; }
.back { color:#ff7a35; font-size:28rpx; margin-bottom:26rpx; }
.team-row,.member-row { display:flex; align-items:center; gap:20rpx; padding:20rpx; }
.team-logo,.avatar { width:76rpx; height:76rpx; border-radius:50%; background:#303030; flex:none; }
.placeholder { display:flex; align-items:center; justify-content:center; color:#ff7a35; }
.team-row view:nth-child(2),.member-main { flex:1; min-width:0; }
.arrow { color:#ff7a35; font-size:46rpx; }
.captain { margin-left:14rpx; color:#ff7a35; font-size:24rpx; }
.check { width:40rpx; height:40rpx; border:2rpx solid #777; border-radius:50%; text-align:center; line-height:36rpx; color:#111; }
.checked { border-color:#ff6b1a; background:#ff6b1a; }
.submit-btn { margin-top:36rpx; background:#ff6b1a; border-radius:12rpx; text-align:center; padding:28rpx; font-size:34rpx; font-weight:650; }
.disabled { opacity:.55; }
