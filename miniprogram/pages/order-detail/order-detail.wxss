.container {
  min-height: 100vh;
  background-color: #0F0F0F;
  padding-bottom: 140rpx;
}

.header {
  background-color: #111111;
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back-btn {
  font-size: 60rpx;
  color: #FF6B1A;
  line-height: 1;
  width: 60rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.header-right { width: 60rpx; }

/* 状态卡片 */
.status-card {
  background: linear-gradient(135deg, #1a0800, #1a1a1a);
  margin: 20rpx 28rpx;
  border-radius: 24rpx;
  padding: 36rpx;
  text-align: center;
  border: 1rpx solid rgba(255,107,26,0.2);
}

.status-icon { font-size: 64rpx; margin-bottom: 12rpx; }
.status-text { font-size: 36rpx; font-weight: 500; color: #FFFFFF; margin-bottom: 8rpx; }
.status-hint { font-size: 24rpx; color: #888888; }

/* 区块 */
.section {
  padding: 0 28rpx;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 22rpx;
  color: #555555;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin: 28rpx 0 16rpx;
}

/* 信息卡片 */
.info-card {
  background-color: #1A1A1A;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #222222;
  gap: 20rpx;
}

.info-row:last-child { border-bottom: none; }

.info-label {
  font-size: 26rpx;
  color: #555555;
  flex-shrink: 0;
  width: 160rpx;
}

.info-value {
  font-size: 26rpx;
  color: #AAAAAA;
  text-align: right;
  flex: 1;
}

.type-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  display: inline-block;
}

.type-tag.match { background-color: #0d2010; color: #3DBB8A; }
.type-tag.ad { background-color: #0d1020; color: #5BA8D4; }

/* 报酬卡片 */
.price-card {
  background-color: #1A1A1A;
  border-radius: 24rpx;
  padding: 24rpx;
}

.price-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.price-label { font-size: 26rpx; color: #555555; }
.price-amount { font-size: 44rpx; font-weight: 500; color: #FFFFFF; }

.price-divider {
  height: 1rpx;
  background-color: #222222;
  margin-bottom: 16rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}

.price-item-label { color: #555555; }
.price-item-value { color: #AAAAAA; }
.price-item-value.deduct { color: #888888; }
.price-item-value.orange { color: #FF6B1A; font-weight: 500; }

.escrow-hint {
  background-color: rgba(255,107,26,0.06);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  font-size: 22rpx;
  color: #888888;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.escrow-lock-icon { width: 28rpx; height: 28rpx; flex-shrink: 0; }

.payout-confirm-card {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background-color: rgba(61,187,138,0.08);
  border: 1rpx solid rgba(61,187,138,0.28);
}

.payout-confirm-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #3DBB8A;
  margin-bottom: 8rpx;
}

.payout-confirm-desc {
  font-size: 24rpx;
  line-height: 1.45;
  color: #888888;
  margin-bottom: 18rpx;
}

.payout-confirm-btn {
  text-align: center;
  padding: 22rpx;
  border-radius: 16rpx;
  background-color: #3DBB8A;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
}

.exception-settlement-card {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background-color: rgba(255, 176, 32, 0.08);
  border: 1rpx solid rgba(255, 176, 32, 0.3);
}

.exception-settlement-card.disputed {
  background-color: rgba(217, 83, 79, 0.1);
  border-color: rgba(217, 83, 79, 0.4);
}

.exception-settlement-title { font-size: 27rpx; font-weight: 600; color: #FFB020; margin-bottom: 8rpx; }
.exception-settlement-card.disputed .exception-settlement-title { color: #E26D66; }
.exception-settlement-desc { font-size: 23rpx; color: #A9A9A9; line-height: 1.5; margin-top: 4rpx; }
.exception-settlement-actions { display: flex; gap: 14rpx; margin-top: 18rpx; }
.exception-dispute-btn, .exception-confirm-btn { flex: 1; text-align: center; padding: 18rpx; border-radius: 14rpx; font-size: 25rpx; }
.exception-dispute-btn { background: rgba(217, 83, 79, 0.16); color: #E26D66; }
.exception-confirm-btn { background: #FF6B1A; color: #FFFFFF; }

/* 报名入口 */
.apply-card {
  background-color: #1A1A1A;
  border-radius: 24rpx;
  padding: 26rpx 24rpx;
  border: 1rpx solid rgba(255,107,26,0.18);
}

.apply-copy {
  margin-bottom: 22rpx;
}

.apply-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.apply-desc {
  font-size: 24rpx;
  color: #888888;
  line-height: 1.5;
}

.detail-apply-btn {
  height: 84rpx;
  border-radius: 18rpx;
  background-color: #FF6B1A;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-apply-btn.status-pending {
  background-color: rgba(255,107,26,0.14);
  color: #FF8C47;
}

.detail-apply-btn.status-approved {
  background-color: rgba(61,187,138,0.14);
  color: #3DBB8A;
}

.detail-apply-btn.status-rejected {
  background-color: rgba(120,120,120,0.14);
  color: #888888;
}

.apply-card.status-approved {
  border-color: rgba(61,187,138,0.24);
}

.apply-card.status-rejected {
  border-color: rgba(120,120,120,0.22);
}

/* 双方信息 */
.party-card {
  background-color: #1A1A1A;
  border-radius: 24rpx;
  padding: 24rpx;
}

.party-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.party-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 500;
  flex-shrink: 0;
  text-align: center;
  line-height: 80rpx;
}

/* 宣传图片 */
.promo-scroll {
  white-space: nowrap;
}

.promo-row {
  display: flex;
  gap: 12rpx;
  padding-bottom: 4rpx;
}

.promo-img {
  width: 240rpx;
  height: 180rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  display: block;
}

.party-avatar.boss { background-color: #2A1800; color: #FF8C47; overflow: hidden; }
.party-avatar.athlete { background-color: #0A2A1A; color: #3DBB8A; overflow: hidden; }

.party-avatar-img {
  width: 80rpx;
  height: 80rpx;
  display: block;
}

.party-info { flex: 1; }
.party-name { font-size: 28rpx; font-weight: 500; color: #FFFFFF; margin-bottom: 4rpx; }
.party-role { font-size: 22rpx; color: #555555; }

.party-verified { font-size: 22rpx; color: #3DBB8A; }
.party-rating { font-size: 22rpx; color: #AAAAAA; }

.party-divider {
  height: 1rpx;
  background-color: #222222;
  margin: 20rpx 0;
}

/* 时间线 */
.timeline {
  background-color: #1A1A1A;
  border-radius: 24rpx;
  padding: 24rpx;
}

.timeline-item {
  display: flex;
  gap: 16rpx;
  position: relative;
}

.tl-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #2A2A2A;
  flex-shrink: 0;
  margin-top: 6rpx;
  z-index: 1;
}

.tl-dot.done { background-color: #FF6B1A; }
.tl-dot.last { margin-bottom: 0; }

.tl-line {
  position: absolute;
  left: 9rpx;
  top: 26rpx;
  width: 2rpx;
  height: 60rpx;
  background-color: #2A2A2A;
}

.tl-line.done { background-color: rgba(255,107,26,0.4); }

.tl-content {
  flex: 1;
  padding-bottom: 40rpx;
}

.tl-title { font-size: 26rpx; color: #FFFFFF; margin-bottom: 4rpx; }
.tl-time { font-size: 22rpx; color: #555555; }

.timeline-item.done .tl-title { color: #FFFFFF; }

/* 底部 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #111111;
  padding: 20rpx 28rpx 40rpx;
  display: flex;
  gap: 16rpx;
  border-top: 1rpx solid #1E1E1E;
}

.msg-btn {
  flex: 1;
  background-color: #1A1A1A;
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #AAAAAA;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.msg-btn-icon { width: 32rpx; height: 32rpx; }

.main-btn {
  flex: 2;
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
}

.main-btn.primary { background-color: #FF6B1A; color: #FFFFFF; }
.main-btn.cancel { background-color: #2A1A1A; color: #888888; }
.main-btn.done { background-color: #0A2A1A; color: #3DBB8A; }
.main-btn.waiting { background-color: #1A2A1A; color: #3DBB8A; }
.main-btn.confirm-pay { background-color: #3DBB8A; color: #FFFFFF; }

/* 评价弹窗 */
.eval-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
  z-index: 9998;
}

.eval-modal {
  position: fixed;
  left: 40rpx; right: 40rpx;
  bottom: calc(110rpx + env(safe-area-inset-bottom));
  max-height: calc(100vh - 380rpx);
  overflow-y: auto;
  box-sizing: border-box;
  background-color: #1A1A1A;
  border-radius: 32rpx;
  padding: 40rpx 36rpx calc(50rpx + env(safe-area-inset-bottom));
  z-index: 9999;
}

.eval-title { font-size: 32rpx; font-weight: 500; color: #FFFFFF; margin-bottom: 6rpx; }
.eval-subtitle { font-size: 22rpx; color: #555555; margin-bottom: 16rpx; }

.eval-risk-tip {
  font-size: 22rpx;
  line-height: 1.5;
  color: #8A6B55;
  background-color: rgba(255, 107, 26, 0.08);
  border: 1rpx solid rgba(255, 107, 26, 0.18);
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 28rpx;
}

.eval-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.eval-label { font-size: 26rpx; color: #888888; width: 80rpx; flex-shrink: 0; }
.eval-options { display: flex; gap: 12rpx; }

.eval-opt {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 40rpx;
  background-color: #2A2A2A;
  color: #666666;
  border: 1rpx solid #2A2A2A;
}

.eval-opt.active { background-color: rgba(61,187,138,0.15); border-color: #3DBB8A; color: #3DBB8A; }
.eval-opt.warn { background-color: rgba(163,45,45,0.15); border-color: #A32D2D; color: #A32D2D; }

.eval-rating-row {
  display: flex;
  align-items: center;
  margin: 8rpx 0 24rpx;
}

.eval-section-title { font-size: 25rpx; color: #FF8C47; margin: 6rpx 0 20rpx; }
.exit-row { align-items: flex-start; }
.eval-options-wrap { flex-wrap: wrap; justify-content: flex-end; }
.eval-points-input { flex: 1; min-width: 0; height: 64rpx; padding: 0 18rpx; box-sizing: border-box; background: #111111; border: 1rpx solid #303030; border-radius: 12rpx; color: #FFFFFF; font-size: 25rpx; }
.eval-settlement-tip { margin: -4rpx 0 24rpx 80rpx; padding: 14rpx 16rpx; background: rgba(255, 176, 32, 0.08); border-radius: 12rpx; color: #B8A37F; font-size: 21rpx; line-height: 1.45; }
.eval-settlement-tip.danger { background: rgba(217, 83, 79, 0.1); color: #E28A84; }

.eval-stars {
  display: flex;
  gap: 8rpx;
}

.eval-star {
  font-size: 44rpx;
  line-height: 1;
  color: #3A3A3A;
  padding: 4rpx 6rpx;
}

.eval-star.active {
  color: #FFB020;
}

.eval-comment {
  width: 100%;
  min-height: 112rpx;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background-color: #111111;
  color: #FFFFFF;
  font-size: 26rpx;
  line-height: 1.5;
}

.eval-btns { display: flex; gap: 16rpx; margin-top: 36rpx; }

.eval-cancel {
  flex: 1; text-align: center; padding: 28rpx;
  border-radius: 20rpx; background-color: #2A2A2A;
  color: #888888; font-size: 28rpx;
}

.eval-confirm {
  flex: 2; text-align: center; padding: 28rpx;
  border-radius: 20rpx; background-color: #FF6B1A;
  color: #FFFFFF; font-size: 28rpx; font-weight: 500;
}

.eval-confirm.disabled { opacity: 0.55; }

.need-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  justify-content: flex-end;
}

.need-tag {
  background: rgba(255, 107, 26, 0.12);
  border: 1rpx solid rgba(255, 107, 26, 0.35);
  color: #FF8C47;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}
