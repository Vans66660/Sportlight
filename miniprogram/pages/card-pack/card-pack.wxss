page { background: #0f0f0f; }
.card-pack-page { min-height: 100vh; color: #fff; background: #0f0f0f; padding-bottom: calc(70rpx + env(safe-area-inset-bottom)); }
.pack-hero { position: relative; overflow: hidden; padding: 70rpx 30rpx 38rpx; background: radial-gradient(circle at 82% 8%, rgba(255,101,20,.32), transparent 32%), linear-gradient(145deg, #24150d, #111 55%); border-bottom: 1rpx solid rgba(255,107,26,.2); }
.pack-hero::after { content: 'S'; position: absolute; right: -22rpx; top: -55rpx; color: rgba(255,107,26,.08); font-size: 330rpx; font-style: italic; font-weight: 900; transform: rotate(-9deg); }
.pack-eyebrow { position: relative; z-index: 1; color: #ff7a2b; font-size: 18rpx; font-weight: 800; letter-spacing: 5rpx; }
.pack-title { position: relative; z-index: 1; margin-top: 10rpx; font-size: 54rpx; font-weight: 900; }
.pack-subtitle { position: relative; z-index: 1; color: #929292; font-size: 23rpx; margin-top: 9rpx; }
.pack-stats { position: relative; z-index: 1; display: flex; gap: 54rpx; margin-top: 38rpx; }
.pack-stats view { display: flex; flex-direction: column; gap: 5rpx; }
.pack-stats text:first-child { font-size: 36rpx; font-weight: 900; }
.pack-stats text:last-child { color: #707070; font-size: 20rpx; }
.pack-content { padding: 34rpx 28rpx; }
.portrait-entry { display: flex; align-items: center; margin-bottom: 36rpx; padding: 20rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 10rpx 30rpx rgba(0,0,0,.18); }
.portrait-library { margin-bottom:36rpx; padding:24rpx; border-radius:22rpx; background:#fff; box-shadow:0 10rpx 30rpx rgba(0,0,0,.18); }
.portrait-library-head { display:flex; align-items:flex-start; justify-content:space-between; gap:20rpx; }
.portrait-quota { flex-shrink:0; padding:8rpx 13rpx; border-radius:14rpx; color:#ff641e; background:#fff1e9; font-size:18rpx; font-weight:800; }
.portrait-slots { display:grid; grid-template-columns:repeat(3,1fr); gap:14rpx; margin-top:20rpx; }
.portrait-slot { position:relative; overflow:hidden; aspect-ratio:3/4; border:2rpx solid #e7e9ec; border-radius:15rpx; background:#f3f5f7; }
.portrait-slot.active { border-color:#ff641e; box-shadow:0 0 0 4rpx rgba(255,100,30,.12); }
.portrait-slot image { width:100%; height:100%; }
.portrait-slot.empty { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3rpx; color:#a1a8b0; border-style:dashed; font-size:18rpx; }
.portrait-slot.empty text:first-child { color:#ff641e; font-size:38rpx; font-weight:300; }
.portrait-active { position:absolute; left:7rpx; bottom:7rpx; padding:4rpx 8rpx; border-radius:8rpx; color:#fff; background:#ff641e; font-size:15rpx; font-weight:800; }
.portrait-entry-preview { width: 84rpx; height: 104rpx; flex-shrink: 0; overflow: hidden; display: flex; align-items: center; justify-content: center; border-radius: 13rpx; color: #ff641e; background: linear-gradient(145deg, #f6f7f8, #eceff2); font-size: 38rpx; }
.portrait-entry-preview image { width: 100%; height: 100%; }
.portrait-entry-copy { min-width: 0; flex: 1; margin-left: 20rpx; }
.portrait-entry-title { color: #172235; font-size: 28rpx; font-weight: 800; }
.portrait-entry-sub { margin-top: 7rpx; color: #7b8490; font-size: 21rpx; }
.portrait-entry-arrow { color: #a6adb5; font-size: 42rpx; }
.pack-section-head { display: flex; align-items: flex-end; justify-content: space-between; }
.pack-section-title { font-size: 31rpx; font-weight: 800; }
.pack-section-desc { color: #666; font-size: 21rpx; margin-top: 7rpx; }
.pack-manage { padding: 11rpx 19rpx; border: 1rpx solid rgba(255,107,26,.52); border-radius: 20rpx; color: #ff8a42; font-size: 22rpx; }
.pack-manage.disabled { color: #555; border-color: #333; }
.pack-showcase-grid, .pack-all-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; margin-top: 22rpx; }
.pack-card { position: relative; overflow: hidden; aspect-ratio: 63 / 88; border-radius: 14rpx; background: #1b1b1b; border: 1rpx solid rgba(255,255,255,.09); }
.pack-card image { display: block; width: 100%; height: 100%; }
.pack-card-placeholder { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: radial-gradient(circle at 62% 25%, rgba(255,107,26,.48), transparent 34%), linear-gradient(155deg, #292929, #101010); }
.pack-card-placeholder text:first-child { color: #ff6514; font-size: 55rpx; font-style: italic; font-weight: 900; }
.pack-card-placeholder text:last-child { color: rgba(255,255,255,.72); font-size: 14rpx; letter-spacing: 2rpx; }
.pack-card-slot { display: flex; align-items: center; justify-content: center; border-style: dashed; color: #454545; font-size: 42rpx; background: rgba(255,255,255,.02); }
.pack-main-badge { position: absolute; left: 8rpx; top: 8rpx; padding: 4rpx 9rpx; color: #fff; background: #ff6514; border-radius: 7rpx; font-size: 16rpx; font-weight: 800; }
.pack-new-badge { position: absolute; right: 7rpx; top: 7rpx; padding: 4rpx 8rpx; border-radius: 7rpx; color: #fff; background: #ff4f00; font-size: 15rpx; font-weight: 900; letter-spacing: 1rpx; }
.pack-showcase-empty { margin-top: 22rpx; padding: 34rpx 24rpx; text-align: center; border: 1rpx dashed rgba(255,255,255,.13); border-radius: 22rpx; background: rgba(255,255,255,.022); }
.empty-stack { display: flex; justify-content: center; align-items: flex-end; height: 78rpx; margin-bottom: 17rpx; }
.empty-stack view { width: 44rpx; height: 62rpx; margin: 0 -7rpx; border: 1rpx solid rgba(255,255,255,.15); border-radius: 7rpx; background: #202020; }
.empty-stack view:first-child { transform: rotate(-12deg); }
.empty-stack view:nth-child(2) { z-index: 2; height: 72rpx; border-color: rgba(255,107,26,.5); background: linear-gradient(145deg, #362116, #181818); }
.empty-stack view:last-child { transform: rotate(12deg); }
.empty-title { color: #ddd; font-size: 25rpx; font-weight: 750; }
.empty-desc { max-width: 490rpx; margin: 9rpx auto 0; color: #626262; font-size: 21rpx; line-height: 1.55; }
.pack-tabs { display: flex; gap: 36rpx; margin-top: 42rpx; border-bottom: 1rpx solid #252525; }
.pack-tab { position: relative; padding: 0 2rpx 17rpx; color: #666; font-size: 25rpx; font-weight: 700; }
.pack-tab.active { color: #fff; }
.pack-tab.active::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1rpx; height: 4rpx; border-radius: 4rpx; background: #ff6514; }
.pack-empty-all { padding: 64rpx 20rpx 30rpx; text-align: center; }
.pack-empty-orbit { position: relative; display: flex; justify-content: center; align-items: center; width: 180rpx; height: 180rpx; margin: 0 auto 25rpx; border: 1rpx solid rgba(255,107,26,.15); border-radius: 50%; }
.pack-empty-orbit::before { content: ''; position: absolute; width: 126rpx; height: 126rpx; border: 1rpx solid rgba(255,255,255,.07); border-radius: 50%; }
.pack-empty-card { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; width: 66rpx; height: 94rpx; border-radius: 9rpx; color: #ff6514; font-size: 39rpx; font-style: italic; font-weight: 900; background: linear-gradient(145deg, #302016, #181818); border: 1rpx solid rgba(255,107,26,.35); transform: rotate(7deg); }
