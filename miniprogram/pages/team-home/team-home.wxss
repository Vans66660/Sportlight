page { background: #0F0F0F; }
.page { min-height: 100vh; color: #FFFFFF; padding-bottom: calc(126rpx + env(safe-area-inset-bottom)); }
.hero { position: relative; height: 460rpx; background: #151515; }
.cover { width: 100%; height: 100%; display: block; }
.cover.placeholder { background: #202020; }
.hero-mask { position: absolute; left: 0; right: 0; bottom: 0; height: 240rpx; background: linear-gradient(transparent, #0F0F0F); }
.hero-info { position: absolute; left: 28rpx; right: 28rpx; bottom: 28rpx; display: flex; align-items: center; gap: 18rpx; }
.logo { width: 96rpx; height: 96rpx; border-radius: 50%; background: #242424; border: 2rpx solid rgba(255,255,255,.18); flex-shrink: 0; }
.logo.text, .member-avatar.text { display: flex; align-items: center; justify-content: center; color: #FF6B1A; font-weight: 800; }
.hero-main { flex: 1; min-width: 0; }
.name { font-size: 38rpx; font-weight: 900; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.meta { margin-top: 8rpx; color: rgba(255,255,255,.72); font-size: 24rpx; }
.recruit { padding: 10rpx 16rpx; border-radius: 10rpx; background: #2A2A2A; color: #888888; font-size: 22rpx; }
.recruit.open { background: rgba(255,107,26,.18); color: #FF8A3D; }
.content { padding: 0 28rpx 28rpx; }
.section { margin-top: 28rpx; }
.section-title { color: #777777; font-size: 22rpx; margin-bottom: 14rpx; }
.desc, .empty { background: #1A1A1A; border: 1rpx solid #2A2A2A; border-radius: 14rpx; padding: 20rpx; color: #CCCCCC; font-size: 26rpx; line-height: 1.6; }
.gallery-scroll { white-space: nowrap; }
.gallery-row { display: flex; gap: 12rpx; }
.gallery-img { width: 220rpx; height: 150rpx; border-radius: 12rpx; background: #202020; flex-shrink: 0; }
.venue-row, .member-row, .challenge-row { background: #1A1A1A; border: 1rpx solid #2A2A2A; border-radius: 14rpx; padding: 18rpx; margin-bottom: 12rpx; }
.venue-name, .challenge-title { font-size: 28rpx; font-weight: 800; }
.venue-address, .challenge-meta { color: #777777; font-size: 23rpx; margin-top: 8rpx; }
.member-row { display: flex; align-items: center; gap: 16rpx; }
.member-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #242424; flex-shrink: 0; }
.member-main { flex: 1; min-width: 0; }
.member-name { font-size: 27rpx; font-weight: 700; }
.member-role { margin-top: 4rpx; color: #777777; font-size: 22rpx; }
.member-score { color: #FF6B1A; font-weight: 900; font-size: 28rpx; }
.bottom-actions { position: fixed; left: 0; right: 0; bottom: 0; padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)); background: rgba(15,15,15,.96); display: flex; gap: 12rpx; box-sizing: border-box; }
.action { flex: 1; height: 82rpx; line-height: 82rpx; text-align: center; border-radius: 12rpx; font-size: 26rpx; font-weight: 800; }
.primary { background: #FF6B1A; color: #FFFFFF; }
.secondary { background: rgba(255,107,26,.14); color: #FF8A3D; border: 1rpx solid rgba(255,107,26,.32); }
.ghost, .disabled { background: #202020; color: #888888; border: 1rpx solid #303030; }
.loading { min-height: 100vh; display: flex; align-items: center; justify-content: center; color: #777777; background: #0F0F0F; }
