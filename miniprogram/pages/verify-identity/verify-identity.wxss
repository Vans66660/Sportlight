page { background: #0F0F0F; }
.container { padding: 48rpx 40rpx; }
.title { font-size: 36rpx; font-weight: 600; color: #fff; margin-bottom: 8rpx; }
.sub { font-size: 26rpx; color: #666; margin-bottom: 40rpx; }
.label { font-size: 24rpx; color: #555; margin-bottom: 10rpx; }
.input-box {
  background: #1A1A1A; border: 1rpx solid #2A2A2A; border-radius: 16rpx;
  padding: 28rpx 24rpx; font-size: 28rpx; color: #fff; width: 100%;
  box-sizing: border-box; margin-bottom: 24rpx; min-height: 88rpx; line-height: 1.4;
}
.hint { font-size: 22rpx; color: #555; margin-bottom: 32rpx; line-height: 1.6; }
.submit-btn {
  width: 100%; background: #FF6B1A; color: #fff; border-radius: 20rpx;
  padding: 28rpx; font-size: 30rpx; font-weight: 500; text-align: center;
  border: none; margin: 0;
}
.submit-btn[disabled] { background: #1A1A1A; color: #444; }
.submit-btn::after { border: none; }
