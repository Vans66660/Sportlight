<view class="container">
  <view class="title">实名认证</view>
  <view class="sub">请输入真实姓名和身份证号完成认证</view>

  <view class="label">真实姓名</view>
  <input class="input-box" placeholder="请输入真实姓名" bindinput="onInput" data-field="realName" value="{{realName}}"/>

  <view class="label">身份证号</view>
  <input class="input-box" type="idcard" placeholder="18位身份证号码" bindinput="onInput" data-field="idCard" value="{{idCard}}" maxlength="18"/>

  <view class="hint">信息仅用于实名核验，加密传输，不会存储明文</view>

  <button class="submit-btn" bindtap="submit" loading="{{loading}}" disabled="{{loading}}">提交认证</button>
</view>
