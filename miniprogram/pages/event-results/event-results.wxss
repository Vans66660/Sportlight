.container {
  min-height: 100vh;
  background-color: #0F0F0F;
  padding-bottom: 60rpx;
}

.page-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background-color: #111111;
  padding: 20rpx 28rpx;
}

.back-btn {
  font-size: 48rpx;
  color: #FFFFFF;
  line-height: 1;
  padding: 0 8rpx;
  flex-shrink: 0;
}

.page-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.page-sub {
  font-size: 22rpx;
  color: #555555;
  margin-top: 4rpx;
}

.event-title-bar {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background-color: rgba(204,136,0,0.1);
  border-left: 4rpx solid #CC8800;
  padding: 20rpx 28rpx;
  margin: 20rpx 24rpx 0;
  border-radius: 0 12rpx 12rpx 0;
}

.event-label { font-size: 28rpx; flex-shrink: 0; }

.event-name {
  font-size: 26rpx;
  color: #DDDDDD;
  line-height: 1.5;
}

.existing-tip {
  font-size: 22rpx;
  color: #5BA8D4;
  text-align: center;
  padding: 16rpx 28rpx 0;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #444444; }

/* 卡片列表 */
.card-list {
  margin-top: 20rpx;
}

.athlete-card {
  background-color: #1A1A1A;
  border-radius: 20rpx;
  margin: 0 24rpx 16rpx;
  overflow: hidden;
  border: 1rpx solid #222222;
}

.athlete-card.card-absent {
  opacity: 0.45;
}

/* 卡片顶行：头像 + 姓名 + 出席切换 */
.card-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 20rpx;
}

.athlete-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background-color: #2A2A2A;
  display: block;
}

.avatar-placeholder {
  background-color: #2A2A2A;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.athlete-name {
  flex: 1;
  font-size: 28rpx;
  color: #DDDDDD;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attend-toggle {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  border-radius: 40rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.attend-toggle.on {
  background-color: rgba(61,187,138,0.15);
  color: #3DBB8A;
}

.attend-toggle.off {
  background-color: #2A2A2A;
  color: #555555;
}

/* 卡片内容区 */
.card-body {
  padding: 16rpx 20rpx 20rpx;
  border-top: 1rpx solid #222222;
}

/* 名次 + 得分 + 备注行 */
.basic-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}

.field-wrap {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.field-wrap.flex1 {
  flex: 1;
  min-width: 0;
}

.field-label {
  font-size: 20rpx;
  color: #555555;
}

.field-input {
  background-color: #222222;
  border-radius: 10rpx;
  padding: 12rpx 14rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  box-sizing: border-box;
  width: 100%;
}

.field-input.short {
  width: 90rpx;
  text-align: center;
}

/* 运动数据区 */
.stats-section {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #222222;
}

.stats-label {
  font-size: 20rpx;
  color: #555555;
  margin-bottom: 14rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 14rpx;
}

.stat-cell {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.stat-lbl {
  font-size: 20rpx;
  color: #555555;
  text-align: center;
}

.stat-input {
  background-color: #222222;
  border-radius: 10rpx;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #FFFFFF;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

/* 底部提示 + 按钮 */
.hint-row {
  padding: 20rpx 28rpx 0;
}

.hint-text {
  font-size: 22rpx;
  color: #444444;
  line-height: 1.6;
}

.submit-btn {
  margin: 32rpx 24rpx 0;
  background-color: #CC8800;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  padding: 28rpx;
  border-radius: 20rpx;
}
