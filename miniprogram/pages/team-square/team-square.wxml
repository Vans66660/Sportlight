<view class="page">
  <view class="title">球队广场</view>
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="index" class="tab {{activeSport === item ? 'active' : ''}}" data-value="{{item}}" bindtap="setSport">{{tabLabels[index]}}</view>
  </view>
  <view wx:if="{{teams.length === 0 && !loading}}" class="empty">暂无球队</view>
  <view wx:for="{{teams}}" wx:key="_id" class="team-card" bindtap="goTeam" data-id="{{item._id}}">
    <image wx:if="{{item.cover}}" class="cover" src="{{item.cover}}" mode="aspectFill"/>
    <view wx:else class="cover placeholder"></view>
    <view class="card-body">
      <image wx:if="{{item.logo}}" class="logo" src="{{item.logo}}" mode="aspectFill"/>
      <view wx:else class="logo text">{{item.logoText || '队'}}</view>
      <view class="main">
        <view class="name">{{item.name}}</view>
        <view class="meta">{{item.sport}} · {{item.memberCount}}人 · 平均{{item.averageScore}}</view>
        <view class="venue">{{item.venues && item.venues.length ? item.venues[0].name : '暂无常驻球馆'}}</view>
      </view>
      <view class="status {{item.recruitmentStatus === 'open' ? 'open' : ''}}">{{item.recruitmentStatus === 'open' ? '招募中' : '暂不招募'}}</view>
    </view>
  </view>
</view>
