page { background: #0F0F0F; }
.page { min-height: 100vh; padding: 28rpx; box-sizing: border-box; color: #FFFFFF; }
.title { font-size: 42rpx; font-weight: 900; margin-bottom: 22rpx; }
.tabs { display: flex; gap: 14rpx; margin-bottom: 22rpx; }
.tab { padding: 14rpx 24rpx; border-radius: 12rpx; background: #1A1A1A; color: #888888; border: 1rpx solid #2A2A2A; font-size: 25rpx; }
.tab.active { background: #FF6B1A; color: #FFFFFF; border-color: #FF6B1A; font-weight: 800; }
.team-card { background: #1A1A1A; border: 1rpx solid #2A2A2A; border-radius: 16rpx; overflow: hidden; margin-bottom: 18rpx; }
.cover { width: 100%; height: 210rpx; display: block; background: #202020; }
.cover.placeholder { background: linear-gradient(135deg, #242424, #151515); }
.card-body { display: flex; align-items: center; gap: 16rpx; padding: 18rpx; }
.logo { width: 74rpx; height: 74rpx; border-radius: 50%; background: #242424; flex-shrink: 0; }
.logo.text { display: flex; align-items: center; justify-content: center; color: #FF6B1A; font-weight: 800; }
.main { flex: 1; min-width: 0; }
.name { font-size: 30rpx; font-weight: 900; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.meta, .venue { color: #777777; font-size: 22rpx; margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.status { padding: 10rpx 14rpx; border-radius: 10rpx; background: #242424; color: #888888; font-size: 22rpx; }
.status.open { color: #FF8A3D; background: rgba(255,107,26,.16); }
.empty { color: #777777; text-align: center; margin-top: 180rpx; font-size: 28rpx; }
