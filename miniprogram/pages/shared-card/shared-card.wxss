page { background: #0f0f0f; }
.shared-page { min-height: 100vh; padding: 42rpx 30rpx calc(70rpx + env(safe-area-inset-bottom)); color: #fff; box-sizing: border-box; background: radial-gradient(circle at 78% 4%, rgba(255,101,20,.22), transparent 27%), #0f0f0f; }
.shared-head { text-align: center; }
.eyebrow { color: #ff7425; font-size: 17rpx; font-weight: 800; letter-spacing: 4rpx; }
.title { margin-top: 12rpx; font-size: 40rpx; font-weight: 900; }
.subtitle { margin-top: 8rpx; color: #777; font-size: 21rpx; }
.card-stage { width: 560rpx; height: 782rpx; margin: 34rpx auto 0; perspective: 1800rpx; }
.card-shell { position: relative; width: 100%; height: 100%; transition: transform .55s; transform-style: preserve-3d; }
.card-shell.show-back { transform: rotateY(180deg); }
.card-face { position: absolute; inset: 0; overflow: hidden; border-radius: 28rpx; backface-visibility: hidden; background: #181818; box-shadow: 0 25rpx 65rpx rgba(0,0,0,.55); border: 1rpx solid rgba(255,255,255,.12); }
.card-face image { display: block; width: 100%; height: 100%; }
.card-back { transform: rotateY(180deg); }
.flip-tip { margin-top: 22rpx; text-align: center; color: #666; font-size: 21rpx; }
.info-card { margin-top: 34rpx; padding: 7rpx 26rpx; border-radius: 22rpx; background: #181818; }
.info-card view { display: flex; justify-content: space-between; gap: 28rpx; padding: 23rpx 0; border-bottom: 1rpx solid #282828; font-size: 22rpx; }
.info-card view:last-child { border: 0; }
.info-card text:first-child { flex-shrink: 0; color: #666; }
.info-card text:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.actions { display: flex; gap: 18rpx; margin-top: 28rpx; }
.actions button { flex: 1; border-radius: 44rpx; font-size: 25rpx; font-weight: 800; line-height: 84rpx; }
.actions button::after { border: 0; }
.outline { color: #ff7b32; border: 1rpx solid rgba(255,107,26,.55); background: transparent; }
.share { color: #fff; background: linear-gradient(135deg, #ff7b2e, #ff4f00); }
.brand-note { margin-top: 32rpx; color: #555; text-align: center; font-size: 20rpx; letter-spacing: 2rpx; }
.state { padding-top: 300rpx; color: #777; text-align: center; font-size: 25rpx; }
.state.error { color: #999; }
.state-mark { margin-bottom: 22rpx; color: #ff6514; font-size: 100rpx; font-style: italic; font-weight: 900; }
