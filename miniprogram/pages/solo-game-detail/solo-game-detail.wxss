page { background: #0F0F0F; }
.container { height: 100vh; background: #0F0F0F; position: relative; }
.scroll { height: 100vh; }
.empty { color: #777; text-align: center; padding-top: 180rpx; }
.hero { margin: 24rpx 28rpx 18rpx; padding: 30rpx; border-radius: 24rpx; background: linear-gradient(135deg,#6B3F1E,#17110D); border: 1rpx solid rgba(255,171,92,0.22); }
.sport { color: #FFB36A; font-size: 24rpx; margin-bottom: 14rpx; }
.title { color: #FFF; font-size: 38rpx; font-weight: 900; line-height: 1.3; margin-bottom: 12rpx; }
.sub { color: rgba(255,255,255,0.72); font-size: 25rpx; }
.stats { display: grid; grid-template-columns: repeat(3,1fr); gap: 12rpx; margin: 0 28rpx 18rpx; }
.stats view { background: #1A1A1A; border: 1rpx solid #282828; border-radius: 18rpx; padding: 18rpx 8rpx; text-align: center; }
.stats text { display: block; color: #FFF; font-size: 30rpx; font-weight: 900; margin-bottom: 6rpx; }
.stats label { color: #777; font-size: 21rpx; }
.pay-card { display: flex; justify-content: space-between; align-items: center; gap: 18rpx; margin: 0 28rpx 18rpx; padding: 20rpx 22rpx; background: #1A1A1A; border: 1rpx solid #282828; border-radius: 18rpx; box-sizing: border-box; }
.pay-label { color: #777; font-size: 24rpx; }
.pay-value { color: #FFB36A; font-size: 26rpx; font-weight: 900; text-align: right; }
.section { margin: 0 28rpx 18rpx; padding: 22rpx; background: #1A1A1A; border: 1rpx solid #282828; border-radius: 20rpx; }
.section-title { color: #FFF; font-size: 28rpx; font-weight: 900; margin-bottom: 16rpx; }
.location-card { display: flex; justify-content: space-between; align-items: center; gap: 18rpx; padding: 18rpx; border-radius: 16rpx; background: #111; }
.loc-name { color: #FFF; font-size: 25rpx; font-weight: 800; margin-bottom: 6rpx; }
.loc-address { color: #777; font-size: 22rpx; line-height: 1.45; }
.loc-action { color: #FFB36A; font-size: 24rpx; flex-shrink: 0; }
.member-row { display: flex; gap: 18rpx; flex-wrap: wrap; }
.member { width: 108rpx; text-align: center; }
.member-avatar { width: 82rpx; height: 82rpx; border-radius: 41rpx; background: #252525; margin: 0 auto 8rpx; }
.empty-avatar { display: flex; align-items: center; justify-content: center; color: #FFB36A; font-size: 30rpx; font-weight: 800; }
.member-name { color: #AAA; font-size: 21rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.notice { color: #B6B6B6; font-size: 24rpx; line-height: 1.7; }
.deadline { color: #777; font-size: 23rpx; margin: 0 28rpx; padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.bottom-bar { position: absolute; left: 0; right: 0; bottom: 0; display: flex; gap: 14rpx; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(15,15,15,0.94); border-top: 1rpx solid #242424; box-sizing: border-box; }
.share-btn, .join-btn { height: 86rpx; line-height: 86rpx; border-radius: 22rpx; text-align: center; font-size: 28rpx; font-weight: 900; padding: 0; margin: 0; }
.share-btn { width: 180rpx; background: #252525; color: #FFF; }
.join-btn { flex: 1; background: #FF6B1A; color: #FFF; }
.join-btn.muted { background: #252525; color: #FFB36A; }
