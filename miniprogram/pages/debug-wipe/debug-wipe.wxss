.container {
  padding: 40rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.warning-box {
  background: #fff3f3;
  border: 2rpx solid #ffcccc;
  border-radius: 16rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.warning-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.warning-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #e64340;
  margin-bottom: 16rpx;
}

.warning-text {
  font-size: 28rpx;
  color: #999;
  line-height: 1.6;
}

.step-box {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.step-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.step-item {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.form-box {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.field-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.input-box {
  height: 84rpx;
  padding: 0 22rpx;
  border-radius: 12rpx;
  background: #f6f6f6;
  font-size: 26rpx;
  color: #222;
}

.btn-admin {
  margin-top: 10rpx;
  margin-bottom: 10rpx;
}

.btn-wipe {
  margin-top: 10rpx;
  margin-bottom: 10rpx;
}

.btn-back {
  background: #f0f0f0;
  color: #666;
}

.result-box {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 30rpx;
  white-space: pre-wrap;
  font-family: monospace;
  font-size: 24rpx;
  color: #333;
}

.result-title {
  font-weight: bold;
  margin-bottom: 10rpx;
  font-size: 28rpx;
}

.checking {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.checking-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.checking-text {
  font-size: 26rpx;
  color: #888;
}
