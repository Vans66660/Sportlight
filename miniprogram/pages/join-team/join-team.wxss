page { background-color: #0F0F0F; min-height: 100vh; }

.page { padding: 32rpx 24rpx; }

.center-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  gap: 24rpx;
}

.tip-text { font-size: 28rpx; color: #555; }
.tip-text.error { color: #E53935; }

.success-icon { font-size: 96rpx; }
.success-title { font-size: 36rpx; font-weight: 600; color: #FFFFFF; }
.success-sub { font-size: 28rpx; color: #3DBB8A; }

.back-btn {
  margin-top: 16rpx;
  padding: 20rpx 48rpx;
  border: 1rpx solid #3A3A3A;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #AAAAAA;
}

.event-card {
  background: #1A1A1A;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.event-label {
  display: block;
  font-size: 22rpx;
  color: #CC8800;
  background: rgba(204,136,0,0.12);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  width: fit-content;
}

.event-title { display: block; font-size: 30rpx; font-weight: 600; color: #FFFFFF; margin-bottom: 12rpx; }
.event-meta { font-size: 24rpx; color: #666; }

.team-card {
  background: #1A1A1A;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.team-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #222;
}

.team-name { font-size: 30rpx; font-weight: 600; color: #FFFFFF; }
.team-count { font-size: 24rpx; color: #666; }

.member-list { padding: 8rpx 0; }

.member-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #1E1E1E;
}

.member-row:last-child { border-bottom: none; }

.member-avatar-wrap { flex-shrink: 0; }

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #2A2A2A;
  display: block;
}

.avatar-placeholder {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #2A2A2A;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.member-name { flex: 1; font-size: 28rpx; color: #DDDDDD; }

.captain-tag {
  font-size: 20rpx;
  color: #CC8800;
  background: rgba(204,136,0,0.12);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.confirmed-tag { font-size: 24rpx; color: #3DBB8A; }
.pending-tag { font-size: 20rpx; color: #888; }

.join-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #CC8800;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 20rpx;
}

.join-hint { display: block; text-align: center; font-size: 22rpx; color: #444; }
