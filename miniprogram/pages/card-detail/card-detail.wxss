page { background: #0f0f0f; }
.detail-page { min-height: 100vh; padding: 44rpx 30rpx 90rpx; color: #fff; box-sizing: border-box; background: radial-gradient(circle at 80% 5%, rgba(255,101,20,.2), transparent 25%), #0f0f0f; }
.detail-head { text-align: center; }
.eyebrow { color: #ff7425; font-size: 17rpx; font-weight: 800; letter-spacing: 5rpx; }
.title { margin-top: 12rpx; font-size: 38rpx; font-weight: 900; }
.subtitle { margin-top: 8rpx; color: #777; font-size: 21rpx; }
.card-stage { width: 560rpx; height: 782rpx; margin: 38rpx auto 0; perspective: 1800rpx; }
.card-shell { position: relative; width: 100%; height: 100%; transition: transform .55s; transform-style: preserve-3d; }
.card-shell.show-back { transform: rotateY(180deg); }
.card-face { position: absolute; inset: 0; overflow: hidden; border-radius: 28rpx; backface-visibility: hidden; background: #181818; box-shadow: 0 25rpx 65rpx rgba(0,0,0,.55); border: 1rpx solid rgba(255,255,255,.12); }
.card-face image { width: 100%; height: 100%; display: block; }
.card-back { transform: rotateY(180deg); }
.card-pending { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20rpx; background: radial-gradient(circle at 65% 28%, rgba(255,107,26,.45), transparent 35%), linear-gradient(150deg, #302015, #111 65%); }
.card-pending text:first-child { color: #ff6514; font-size: 145rpx; font-weight: 900; font-style: italic; }
.card-pending text:last-child { color: rgba(255,255,255,.7); font-size: 24rpx; letter-spacing: 5rpx; }
.card-pending.back text:first-child { color: #fff; font-size: 36rpx; font-style: normal; }
.flip-tip { margin-top: 24rpx; text-align: center; color: #666; font-size: 21rpx; }
.actions { display: flex; gap: 18rpx; margin: 34rpx auto 0; max-width: 560rpx; }
.action { flex: 1; border-radius: 44rpx; font-size: 25rpx; font-weight: 800; line-height: 82rpx; }
.action::after { border: 0; }
.action.primary { color: #fff; background: #ff6514; }
.action.secondary { color: #ff7b32; border: 1rpx solid rgba(255,107,26,.55); background: transparent; }
.share-ready { margin-top: 16rpx; color: #6f6f6f; text-align: center; font-size: 19rpx; }
.meta { margin-top: 42rpx; padding: 8rpx 27rpx; border-radius: 22rpx; background: #181818; }
.meta view { display: flex; justify-content: space-between; padding: 25rpx 0; border-bottom: 1rpx solid #282828; font-size: 23rpx; }
.meta view:last-child { border: 0; }
.meta text:first-child { color: #666; }
.state { padding-top: 300rpx; color: #777; text-align: center; font-size: 25rpx; }
