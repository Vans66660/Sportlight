page { background: #0F0F0F; }
.container { min-height: 100vh; padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); background: #0F0F0F; box-sizing: border-box; }
.date-tabs { display: flex; gap: 12rpx; overflow: hidden; margin-bottom: 20rpx; }
.date-tab { flex: 1; min-width: 0; height: 88rpx; border-radius: 16rpx; background: #1A1A1A; border: 1rpx solid #282828; color: #777; display: flex; flex-direction: column; justify-content: center; align-items: center; font-size: 24rpx; }
.date-tab text { font-size: 20rpx; margin-top: 4rpx; }
.date-tab.active { background: #FF6B1A; color: #FFF; border-color: #FF6B1A; }
.toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.sort-btn, .create-btn { height: 62rpx; line-height: 62rpx; border-radius: 31rpx; padding: 0 24rpx; font-size: 24rpx; }
.sort-btn { background: #1A1A1A; border: 1rpx solid #2A2A2A; color: #FFF; }
.create-btn { background: #FF6B1A; color: #FFF; font-weight: 800; }
.hint { color: #666; font-size: 22rpx; margin-bottom: 18rpx; }
.empty { color: #777; text-align: center; padding: 120rpx 0; font-size: 26rpx; }
.game-card { display: flex; gap: 18rpx; background: #1A1A1A; border: 1rpx solid #282828; border-radius: 20rpx; padding: 20rpx; margin-bottom: 16rpx; }
.avatar { width: 86rpx; height: 86rpx; border-radius: 43rpx; background: #252525; flex-shrink: 0; }
.empty-avatar { display: flex; align-items: center; justify-content: center; color: #FFB36A; font-size: 32rpx; font-weight: 800; }
.game-main { flex: 1; min-width: 0; }
.game-head { display: flex; justify-content: space-between; gap: 14rpx; margin-bottom: 8rpx; }
.creator { color: #FFF; font-size: 28rpx; font-weight: 800; }
.distance { color: #FFB36A; font-size: 23rpx; flex-shrink: 0; }
.score-line, .time-line, .venue-line { color: #888; font-size: 23rpx; line-height: 1.55; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.people-line { margin-top: 10rpx; font-size: 24rpx; font-weight: 800; }
.people-line.formed { color: #FF6B1A; }
.people-line.waiting { color: #3DBB8A; }
.people-line text { font-weight: 500; }
