page { background: #0F0F0F; }
.page { min-height: 100vh; padding: 28rpx; box-sizing: border-box; color: #FFFFFF; padding-bottom: calc(126rpx + env(safe-area-inset-bottom)); }
.versus-card, .info-card, .apply-card, .member-row, .empty { background: #1A1A1A; border: 1rpx solid #2A2A2A; border-radius: 16rpx; padding: 20rpx; margin-bottom: 16rpx; box-sizing: border-box; }
.versus-card { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.team-side { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.team-logo { width: 84rpx; height: 84rpx; border-radius: 50%; background: #242424; }
.team-logo.text, .avatar.text { display: flex; align-items: center; justify-content: center; color: #FF6B1A; font-weight: 900; }
.team-name { max-width: 100%; font-size: 28rpx; font-weight: 900; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.score { color: #777777; font-size: 22rpx; }
.vs { color: #FF6B1A; font-size: 32rpx; font-weight: 900; }
.info-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; padding: 12rpx 0; color: #CCCCCC; font-size: 25rpx; }
.info-row text:first-child { color: #777777; flex-shrink: 0; }
.info-row text:last-child { text-align: right; }
.desc { margin-top: 12rpx; color: #CCCCCC; line-height: 1.6; font-size: 25rpx; }
.section-title { color: #777777; font-size: 22rpx; margin: 28rpx 0 12rpx; }
.apply-card, .member-row { display: flex; align-items: center; gap: 16rpx; }
.apply-main, .member-main { flex: 1; min-width: 0; }
.apply-name, .member-name { font-size: 28rpx; font-weight: 800; }
.apply-meta, .member-team, .empty { color: #777777; font-size: 23rpx; margin-top: 6rpx; }
.mini-actions { display: flex; gap: 10rpx; }
.mini-btn { padding: 12rpx 18rpx; border-radius: 10rpx; font-size: 23rpx; font-weight: 800; }
.primary { background: #FF6B1A; color: #FFFFFF; }
.ghost { background: #242424; color: #888888; }
.apply-status { color: #FF8A3D; font-size: 23rpx; }
.avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #242424; flex-shrink: 0; }
.member-score { color: #FF6B1A; font-weight: 900; }
.bottom-actions { position: fixed; left: 0; right: 0; bottom: 0; padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)); background: rgba(15,15,15,.96); display: flex; gap: 12rpx; box-sizing: border-box; }
.action { flex: 1; height: 82rpx; line-height: 82rpx; text-align: center; border-radius: 12rpx; font-size: 28rpx; font-weight: 900; }

.share-btn-native { margin: 0; padding: 0; background: #FF6B1A; color: #fff; }
.share-btn-native::after { border: none; }
.loading { min-height: 100vh; display: flex; align-items: center; justify-content: center; color: #777777; background: #0F0F0F; }
