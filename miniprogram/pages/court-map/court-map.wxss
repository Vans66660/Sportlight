page {
  background: #0F0F0F;
}

.container {
  height: 100vh;
  background: #0F0F0F;
  position: relative;
}

.court-map {
  width: 100%;
  height: 100%;
}

.map-tip {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  top: 28rpx;
  padding: 16rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(17, 17, 17, 0.86);
  color: #FFFFFF;
  font-size: 23rpx;
  text-align: center;
}

.dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin: 0 8rpx 0 18rpx;
}

.dot:first-child {
  margin-left: 0;
}

.dot.green {
  background: #19B56B;
}

.dot.red {
  background: #E94B35;
}

.dot.blue {
  background: #1F7AFF;
}

.venue-panel {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  max-height: 46vh;
  border-radius: 24rpx;
  background: rgba(17, 17, 17, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  padding: 22rpx;
  box-sizing: border-box;
  backdrop-filter: blur(18rpx);
}

.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.panel-title {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 4rpx;
}

.panel-sub {
  color: #777777;
  font-size: 22rpx;
}

.refresh-btn {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  color: #FFB36A;
  border: 1rpx solid rgba(255, 107, 26, 0.38);
  font-size: 23rpx;
  flex-shrink: 0;
}

.venue-list {
  max-height: calc(46vh - 112rpx);
}

.venue-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #1A1A1A;
  border: 1rpx solid #282828;
  margin-bottom: 12rpx;
}

.venue-card.active {
  border-color: rgba(255, 107, 26, 0.68);
  background: rgba(255, 107, 26, 0.12);
}

.venue-cover {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  background: #252525;
  flex-shrink: 0;
}

.venue-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #777777;
  font-size: 22rpx;
}

.venue-main {
  flex: 1;
  min-width: 0;
}

.venue-name {
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 800;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.venue-meta,
.venue-address,
.venue-courts {
  color: #888888;
  font-size: 21rpx;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-pill {
  display: inline-block;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  color: #FFFFFF;
  font-size: 19rpx;
  margin-right: 8rpx;
  vertical-align: middle;
}

.status-pill.joinable {
  background: #19B56B;
}

.status-pill.full {
  background: #E94B35;
}

.status-pill.empty {
  background: #1F7AFF;
}

.venue-courts {
  color: #FFB36A;
  margin-top: 4rpx;
}

.venue-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex-shrink: 0;
}

.venue-action {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 18rpx;
  border-radius: 28rpx;
  background: #FF6B1A;
  color: #FFFFFF;
  font-size: 23rpx;
  font-weight: 700;
  text-align: center;
}

.venue-action.ghost {
  color: #FFB36A;
  background: rgba(255, 107, 26, 0.14);
}

.empty-card {
  padding: 36rpx 20rpx;
  border-radius: 18rpx;
  background: #1A1A1A;
  border: 1rpx solid #282828;
  color: #777777;
  font-size: 24rpx;
  text-align: center;
}
