page { background: #0F0F0F; }
.page { min-height: 100vh; padding: 28rpx; box-sizing: border-box; color: #FFFFFF; padding-bottom: calc(130rpx + env(safe-area-inset-bottom)); }
.form-card { background: #151515; border: 1rpx solid #262626; border-radius: 16rpx; padding: 22rpx; }
.label { color: #888888; font-size: 24rpx; margin: 24rpx 0 12rpx; }
.cover-picker { height: 260rpx; border-radius: 14rpx; background: #202020; overflow: hidden; display: flex; align-items: center; justify-content: center; }
.cover-img { width: 100%; height: 100%; }
.logo-picker { width: 120rpx; height: 120rpx; border-radius: 50%; background: #202020; overflow: hidden; display: flex; align-items: center; justify-content: center; }
.logo-img { width: 100%; height: 100%; }
.upload-plus { color: #777777; font-size: 72rpx; }
.upload-plus.small { font-size: 48rpx; }
.input, .textarea {
  width: 100%;
  background: #202020;
  border: 1rpx solid #303030;
  color: #FFFFFF;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}
.input {
  display: block;
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 22rpx;
}
.textarea {
  min-height: 210rpx;
  line-height: 1.55;
  padding: 22rpx;
}
.input-placeholder { color: #666666; }
.seg-row { display: flex; gap: 14rpx; flex-wrap: wrap; }
.seg { padding: 16rpx 26rpx; background: #202020; border: 1rpx solid #303030; color: #888888; border-radius: 12rpx; font-size: 26rpx; }
.seg.active { background: #FF6B1A; border-color: #FF6B1A; color: #FFFFFF; font-weight: 700; }
.gallery { display: flex; flex-wrap: wrap; gap: 12rpx; }
.gallery-item, .gallery-add { position: relative; width: 142rpx; height: 142rpx; border-radius: 12rpx; overflow: hidden; background: #202020; display: flex; align-items: center; justify-content: center; color: #777777; font-size: 42rpx; }
.gallery-img { width: 100%; height: 100%; }
.delete { position: absolute; right: 6rpx; top: 6rpx; width: 36rpx; height: 36rpx; border-radius: 50%; background: rgba(0,0,0,.65); color: #FFFFFF; text-align: center; line-height: 34rpx; }
.venue-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; background: #202020; border: 1rpx solid #303030; border-radius: 12rpx; padding: 18rpx; margin-bottom: 12rpx; }
.venue-row.selected { border-color: #FF6B1A; background: rgba(255,107,26,.1); }
.venue-name { font-size: 28rpx; font-weight: 700; }
.venue-address, .hint { margin-top: 8rpx; color: #777777; font-size: 22rpx; }
.check { width: 44rpx; color: #FF6B1A; font-size: 34rpx; text-align: center; }
.submit { position: fixed; left: 28rpx; right: 28rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); height: 88rpx; line-height: 88rpx; text-align: center; background: #FF6B1A; color: #FFFFFF; border-radius: 14rpx; font-size: 30rpx; font-weight: 800; }
