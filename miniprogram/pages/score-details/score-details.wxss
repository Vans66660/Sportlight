page {
  background: #0F0F0F;
}

.container {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  background: #0F0F0F;
}

.page-title {
  color: #FFFFFF;
  font-size: 42rpx;
  font-weight: 900;
}

.page-sub {
  color: #777777;
  font-size: 24rpx;
  line-height: 1.55;
  margin-top: 12rpx;
}

.empty {
  color: #777777;
  text-align: center;
  padding-top: 180rpx;
  font-size: 28rpx;
}

.log-list {
  margin-top: 32rpx;
}

.log-card {
  background: #1A1A1A;
  border: 1rpx solid #292929;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.log-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.log-title {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 800;
}

.log-meta {
  color: #777777;
  font-size: 23rpx;
  line-height: 1.45;
  margin-top: 8rpx;
}

.delta {
  font-size: 38rpx;
  font-weight: 900;
  white-space: nowrap;
}

.plus {
  color: #FF8A3D;
}

.minus {
  color: #49C17B;
}

.score-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.score-box {
  background: #111111;
  border-radius: 16rpx;
  padding: 18rpx;
}

.score-label {
  color: #777777;
  font-size: 23rpx;
}

.score-value {
  font-size: 34rpx;
  font-weight: 900;
  margin-top: 8rpx;
}

.cap-note {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  color: #FFB36A;
  background: rgba(255, 107, 26, 0.1);
  border: 1rpx solid rgba(255, 107, 26, 0.24);
  font-size: 22rpx;
  line-height: 1.45;
}
