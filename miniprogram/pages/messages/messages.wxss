.container {
  min-height: 100vh;
  background-color: #0F0F0F;
  display: flex;
  flex-direction: column;
}

.header {
  background-color: #111111;
  padding: 20rpx 28rpx 16rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.list-scroll {
  flex: 1;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.message-section-title {
  padding: 20rpx 28rpx 12rpx;
  color: #767676;
  background: #0F0F0F;
  font-size: 22rpx;
  font-weight: 600;
}

.conversation-title {
  padding-top: 26rpx;
}

/* 滑动删除 */
.swipe-wrap {
  overflow: hidden;
  position: relative;
}

.swipe-inner {
  display: flex;
  align-items: stretch;
}

.swipe-inner.snap {
  transition: transform 0.2s ease;
}

.msg-row {
  flex: 0 0 100vw;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #1A1A1A;
  box-sizing: border-box;
}

.delete-action {
  flex: 0 0 160rpx;
  background-color: #E53935;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-label {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
}

.msg-row.unread {
  background-color: rgba(255, 107, 26, 0.03);
}

.msg-row.pinned {
  background-color: rgba(255, 183, 0, 0.05);
  border-left: 4rpx solid #FFB700;
}

.avatar-gold {
  border: 3rpx solid #FFB700 !important;
}

.msg-name.gold {
  color: #FFB700;
}

.msg-sub-title.gold-sub {
  color: #7A6000;
}

.pinned-tag {
  font-size: 20rpx;
  color: #FFB700;
  background-color: rgba(255, 183, 0, 0.12);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
  font-weight: 400;
}

.pinned-dot {
  position: absolute;
  top: 0;
  right: 0;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background-color: #FFB700;
  border: 3rpx solid #0F0F0F;
}

.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.avatar-img {
  display: block;
}

.avatar-text {
  background-color: #2A2A2A;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.unread-dot {
  position: absolute;
  top: 0;
  right: 0;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #FF6B1A;
  border: 3rpx solid #0F0F0F;
}

.unread-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background-color: #E53935;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  text-align: center;
  line-height: 32rpx;
  padding: 0 6rpx;
  border: 3rpx solid #0F0F0F;
}

.msg-preview.unread {
  color: #FFFFFF;
  font-weight: 500;
}

.msg-info { flex: 1; min-width: 0; }

.msg-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.msg-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.msg-sub-title {
  font-size: 22rpx;
  color: #444444;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-time {
  font-size: 22rpx;
  color: #555555;
  flex-shrink: 0;
}

.msg-preview {
  font-size: 24rpx;
  color: #555555;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-row.unread .msg-preview {
  color: #AAAAAA;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 30rpx; color: #FFFFFF; margin-bottom: 12rpx; }
.empty-hint { font-size: 26rpx; color: #555555; }

.notif-row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: #111111;
  border-bottom: 1rpx solid #1E1E1E;
  gap: 20rpx;
}

.notif-icon-wrap {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.notif-icon {
  font-size: 40rpx;
}

.notif-icon-img {
  width: 76rpx;
  height: 88rpx;
  display: block;
}

.msg-status {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.status-locked    { color: #FFB700; background-color: rgba(255, 183, 0, 0.12); }
.status-done      { color: #3DBB8A; background-color: rgba(61, 187, 138, 0.1); }
.status-open      { color: #5BA8D4; background-color: rgba(91, 168, 212, 0.1); }
.status-cancelled { color: #555555; background-color: rgba(85, 85, 85, 0.15); }

.notif-arrow {
  font-size: 36rpx;
  color: #444444;
  flex-shrink: 0;
}
