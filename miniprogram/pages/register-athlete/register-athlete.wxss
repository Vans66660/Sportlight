.container {
  min-height: 100vh;
  background-color: #0F0F0F;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

page { overflow-x: hidden; }

/* 顶部导航 */
.header {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  background-color: #111111;
  gap: 20rpx;
}

.back {
  font-size: 48rpx;
  color: #FF6B1A;
  line-height: 1;
  padding: 10rpx;
}

/* 进度条 */
.step-bar {
  flex: 1;
  display: flex;
  align-items: center;
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #1A1A1A;
  color: #555;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-dot.active {
  background-color: #FF6B1A;
  color: #fff;
}

.step-dot.done {
  background-color: #2A2A2A;
  color: #FF8C47;
}

.step-line {
  flex: 1;
  height: 4rpx;
  background-color: #2A2A2A;
}

.step-line.done {
  background-color: rgba(255, 107, 26, 0.4);
}

/* 内容区 */
.step-content {
  padding: 36rpx 40rpx 0;
  box-sizing: border-box;
  width: 100%;
  overflow-x: hidden;
}

.step-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #fff;
  margin-bottom: 8rpx;
}

.step-sub {
  font-size: 24rpx;
  color: #555;
  margin-bottom: 24rpx;
}

/* 表单元素 */
.label {
  font-size: 24rpx;
  color: #555;
  margin-bottom: 10rpx;
}

/* 内联行 */
.inline-row {
  display: flex;
  gap: 16rpx;
}

.inline-item {
  flex: 1;
  min-width: 0;
}

.input-box {
  background-color: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 16rpx;
  padding: 28rpx 28rpx;
  font-size: 28rpx;
  color: #fff;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  line-height: 1.4;
  min-height: 88rpx;
}

.textarea-box {
  background-color: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 26rpx;
  color: #fff;
  width: 100%;
  height: 180rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.select-box {
  background-color: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 16rpx;
  padding: 28rpx 28rpx;
  font-size: 28rpx;
  color: #444;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
  min-height: 88rpx;
  line-height: 1.4;
}

.arrow { color: #444; }

.compact-select {
  margin-bottom: 0;
}

.phone-auth-card {
  background-color: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.phone-auth-card.phone-auth-simple {
  padding: 0;
  border: none;
  background: transparent;
  display: block;
}

.phone-auth-card.done {
  border-color: #1a3a20;
  background-color: #0d1a0e;
}

.phone-auth-card.phone-auth-simple.done {
  border: none;
  background: transparent;
}

.phone-auth-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.phone-auth-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background-color: rgba(91, 168, 212, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.phone-auth-info {
  min-width: 0;
}

.phone-auth-title {
  font-size: 26rpx;
  color: #fff;
  margin-bottom: 4rpx;
}

.phone-auth-desc {
  font-size: 22rpx;
  color: #555;
  word-break: break-all;
}

.phone-auth-btn {
  margin: 0;
  padding: 8rpx 20rpx;
  line-height: 1.4;
  border-radius: 12rpx;
  background-color: rgba(255, 107, 26, 0.08);
  border: 1rpx solid rgba(255, 107, 26, 0.3);
  color: #FF6B1A;
  font-size: 22rpx;
  flex-shrink: 0;
}

.phone-auth-btn-full {
  width: 100%;
  min-height: 88rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  background-color: rgba(255, 107, 26, 0.12);
}

.phone-auth-btn-full.done {
  opacity: 0.8;
  color: #FF6B1A;
}

.phone-auth-btn::after {
  border: none;
}

/* 照片上传 */
.avatar-upload-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 128rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 28rpx;
  box-sizing: border-box;
  border: 1rpx solid #2A2A2A;
  border-radius: 20rpx;
  background: #171717;
}

.avatar-upload {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 107, 26, 0.72);
  border-radius: 50%;
  background: #222;
}

.avatar-preview {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  color: #FF6B1A;
  font-size: 52rpx;
  font-weight: 300;
  line-height: 82rpx;
  text-align: center;
}

.avatar-upload-copy {
  min-width: 0;
}

.avatar-upload-title {
  color: #F5F5F5;
  font-size: 28rpx;
  font-weight: 600;
}

.avatar-upload-desc {
  margin-top: 8rpx;
  color: #777;
  font-size: 23rpx;
}

.photo-upload {
  width: 100%;
  aspect-ratio: 3/4;
  background-color: #1A1A1A;
  border: 3rpx dashed #2A2A2A;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  overflow: hidden;
  position: relative;
}

.photo-preview {
  width: 100%;
  height: 100%;
}

.photo-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.photo-icon { font-size: 48rpx; }
.photo-hint { font-size: 28rpx; color: #555; }
.photo-hint2 { font-size: 22rpx; color: #333; }

/* 上传按钮 */
.upload-btn-orange {
  background-color: rgba(255, 107, 26, 0.12);
  color: #FF6B1A;
  border-radius: 16rpx;
  padding: 14rpx 32rpx;
  font-size: 24rpx;
  margin-top: 16rpx;
}

/* 性别 */
.gender-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.gender-btn {
  flex: 1;
  background-color: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 20rpx;
  padding: 22rpx;
  text-align: center;
  font-size: 28rpx;
  color: #555;
}

.gender-btn.active {
  background-color: rgba(255, 107, 26, 0.12);
  border-color: #FF6B1A;
  color: #FF6B1A;
}

/* ===== 标签行 ===== */
.tag-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.tag-btn {
  flex: 1;
  min-width: 120rpx;
  text-align: center;
  white-space: nowrap;
  background-color: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  font-size: 26rpx;
  color: #888;
  line-height: 1.3;
}

.tag-row.col-3 {
  flex-direction: column;
}

.tag-row.col-3 .tag-btn {
  padding: 24rpx 28rpx;
  font-size: 26rpx;
  flex: none;
  text-align: left;
}

.tag-row.col-4 .tag-btn {
  padding: 16rpx 6rpx;
  font-size: 20rpx;
}

.position-row .tag-btn {
  flex: 0 0 calc((100% - 28rpx) / 3);
  box-sizing: border-box;
}

.tag-btn.active {
  background-color: rgba(255, 107, 26, 0.12);
  border-color: #FF6B1A;
  color: #FF6B1A;
}

.tag-btn.disabled {
  opacity: 0.35;
}

/* 报价 */
.price-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.price-box {
  flex: 1;
  background-color: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.price-label {
  font-size: 20rpx;
  color: #555;
  margin-bottom: 8rpx;
}

.price-input-wrap {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.currency { font-size: 24rpx; color: #555; }
.price-input { font-size: 36rpx; font-weight: 500; color: #fff; flex: 1; }
.price-unit { font-size: 22rpx; color: #555; }

.divider {
  height: 1rpx;
  background-color: #1E1E1E;
  margin: 28rpx 0;
}

.hint-box {
  background-color: rgba(255, 107, 26, 0.06);
  border: 1rpx solid rgba(255, 107, 26, 0.2);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #FF8C47;
  margin-bottom: 20rpx;
}

.hint-box-green {
  background-color: rgba(61, 187, 138, 0.06);
  border: 1rpx solid rgba(61, 187, 138, 0.2);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #3DBB8A;
  margin-bottom: 20rpx;
}

.hint-box-orange {
  background-color: rgba(255, 107, 26, 0.06);
  border: 1rpx solid rgba(255, 107, 26, 0.2);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #FF8C47;
  margin-bottom: 20rpx;
}

.material-hint {
  background-color: rgba(255, 107, 26, 0.08);
  border: 1rpx solid rgba(255, 107, 26, 0.28);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 22rpx;
  color: #FFB36A;
  font-size: 24rpx;
  line-height: 1.5;
}

/* 资质上传 */
.upload-card {
  background-color: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.upload-card.uploaded {
  border-color: #1a3a20;
  background-color: #0d1a0e;
}

.upload-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.upload-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.upload-emoji { font-size: 36rpx; }
.upload-name { font-size: 26rpx; font-weight: 500; color: #fff; }
.upload-desc { font-size: 22rpx; color: #555; margin-top: 4rpx; }

.required-badge {
  font-size: 20rpx;
  color: #FF6B1A;
  background-color: rgba(255, 107, 26, 0.1);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.optional-badge {
  font-size: 20rpx;
  color: #555;
  background-color: #1E1E1E;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.done-badge {
  font-size: 20rpx;
  color: #3DBB8A;
  background-color: rgba(61, 187, 138, 0.1);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.upload-btn-wrap { margin-top: 8rpx; }

.upload-action-btn {
  display: inline-block;
  background-color: rgba(255, 107, 26, 0.12);
  color: #FF6B1A;
  border-radius: 12rpx;
  padding: 12rpx 28rpx;
  font-size: 24rpx;
}

.upload-action-btn-gray {
  display: inline-block;
  background-color: #1E1E1E;
  color: #666;
  border-radius: 12rpx;
  padding: 12rpx 28rpx;
  font-size: 24rpx;
}

.uploaded-file {
  background-color: rgba(61, 187, 138, 0.06);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  color: #aaa;
}

/* 完成页 */
.complete-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
}

.complete-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background-color: rgba(255, 107, 26, 0.15);
  border: 4rpx solid #FF6B1A;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-bottom: 32rpx;
}

.complete-title {
  font-size: 44rpx;
  font-weight: 500;
  color: #fff;
  margin-bottom: 12rpx;
}

.complete-sub {
  font-size: 28rpx;
  color: #888;
  margin-bottom: 40rpx;
}

.complete-card {
  background-color: #1A1A1A;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  width: 100%;
  margin-bottom: 32rpx;
}

.complete-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #2A2A2A;
}

.complete-label { font-size: 26rpx; color: #555; }
.complete-value { font-size: 26rpx; color: #FF6B1A; }

.rank-badge {
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 18rpx;
  border-radius: 10rpx;
}

.rank-f { color: #FF8C47; background-color: #2A1800; }

.lock-pill {
  font-size: 22rpx;
  color: #555;
  background-color: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 10rpx;
  padding: 6rpx 18rpx;
}

.complete-hint {
  font-size: 24rpx;
  color: #555;
  margin-top: 20rpx;
  text-align: center;
}

/* 按钮 */
.btn-next {
  width: calc(100% - 64rpx);
  margin-left: auto;
  margin-right: auto;
  background-color: #FF6B1A;
  color: #fff;
  border-radius: 20rpx;
  padding: 22rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  margin-top: 16rpx;
  margin-bottom: 12rpx;
}

.btn-next[disabled] {
  background-color: #1A1A1A;
  color: #444;
}

.btn-prev {
  width: calc(100% - 64rpx);
  margin-left: auto;
  margin-right: auto;
  background-color: #1A1A1A;
  color: #666;
  border-radius: 20rpx;
  padding: 22rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
  margin-bottom: 12rpx;
}

.btn-next.active { background-color: #FF6B1A; color: #fff; }
.btn-next.disabled { background-color: #1A1A1A; color: #444; }

/* ===== 必填星号 ===== */
.required { color: #FF6B1A; }
.placeholder { color: #444; }

/* ===== 提示文字 ===== */
.module-hint {
  font-size: 22rpx;
  color: #555;
  line-height: 1.6;
  margin-top: -16rpx;
  margin-bottom: 16rpx;
}

/* ===== 履历模块卡片 ===== */
.module-card {
  background-color: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
}

.qa-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #FF6B1A;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.qa-num-small {
  display: inline-block;
  background-color: rgba(255,107,26,0.12);
  color: #FF6B1A;
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 14rpx;
  border-radius: 16rpx;
  margin-bottom: 10rpx;
}

.qa-question {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 6rpx;
}

.qa-desc {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 16rpx;
}

/* ===== 证明材料上传 ===== */
.proof-section {
  margin-top: 8rpx;
}

.proof-upload {
  width: 100%;
  height: 180rpx;
  border-radius: 14rpx;
  background-color: #111;
  border: 2rpx dashed #2A2A2A;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.proof-upload.optional-proof {
  margin-top: 14rpx;
}

.proof-preview { width: 100%; height: 100%; }
.proof-placeholder { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.proof-icon { font-size: 48rpx; }
.proof-hint { font-size: 26rpx; color: #888; }
.proof-sub { font-size: 22rpx; color: #555; }

.proof-status {
  font-size: 22rpx;
  color: #FF6B1A;
  margin-bottom: 4rpx;
}

.audit-hint {
  margin-top: 18rpx;
  padding-bottom: 12rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.5;
  color: #666666;
}
