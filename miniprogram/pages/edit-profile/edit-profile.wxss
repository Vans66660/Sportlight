.container {
  min-height: 100vh;
  background-color: #0F0F0F;
  padding-bottom: 60rpx;
}

.header {
  background-color: #111111;
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back-btn {
  font-size: 60rpx;
  color: #FF6B1A;
  line-height: 1;
  width: 60rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.save-btn {
  font-size: 28rpx;
  color: #FF6B1A;
  font-weight: 500;
}

.section {
  padding: 28rpx 28rpx 0;
}

.section-title {
  font-size: 22rpx;
  color: #555555;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

.photo-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.profile-photo {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background-color: #1A1A1A;
  margin-bottom: 16rpx;
}

.photo-edit {
  font-size: 26rpx;
  color: #FF6B1A;
}

.label {
  font-size: 24rpx;
  color: #555555;
  margin-bottom: 10rpx;
  margin-top: 24rpx;
}

.input-box {
  background-color: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 20rpx;
  padding: 0 28rpx;
  height: 88rpx;
  min-height: 88rpx;
  line-height: normal;
  font-size: 28rpx;
  color: #FFFFFF;
  width: 100%;
  box-sizing: border-box;
}

.input-disabled {
  color: #666666;
  opacity: 0.7;
}

.textarea-box {
  background-color: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
  margin-top: 10rpx;
}



.input-placeholder {
  color: #555555;
}

.inline-row {
  display: flex;
  gap: 16rpx;
}

.inline-item {
  flex: 1;
  min-width: 0;
}

.select-box {
  background-color: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #444444;
  display: flex;
  justify-content: space-between;
}

.arrow { color: #444; }

.phone-status-card {
  margin-top: 24rpx;
  background-color: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.phone-status-title {
  font-size: 26rpx;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.phone-status-desc {
  font-size: 22rpx;
  color: #666666;
}

.phone-status-badge {
  flex-shrink: 0;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  background-color: #2A1800;
  color: #FF8C47;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.phone-status-badge.done {
  background-color: #0A2A1A;
  color: #3DBB8A;
}

.tag-row {
  display: flex;
  gap: 16rpx;
}

.tag-btn {
  background-color: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 40rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #888888;
}

.tag-btn.active {
  background-color: rgba(255, 107, 26, 0.15);
  border-color: #FF6B1A;
  color: #FF6B1A;
}

.price-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.price-box {
  flex: 1;
  background-color: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.price-label {
  font-size: 20rpx;
  color: #555555;
  margin-bottom: 8rpx;
}

.price-input-wrap {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.currency { font-size: 24rpx; color: #555555; }
.price-input { font-size: 36rpx; font-weight: 500; color: #FFFFFF; flex: 1; min-height: 54rpx; line-height: normal; }

.qualification-row {
  background-color: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.qualification-row:active {
  border-color: rgba(255, 107, 26, 0.48);
  background-color: rgba(255, 107, 26, 0.08);
}

.qualification-row.no-border {
  margin-bottom: 0;
}

.qualification-title {
  font-size: 26rpx;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.qualification-desc {
  font-size: 22rpx;
  color: #666666;
}

.qualification-badge {
  flex-shrink: 0;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  background-color: #242424;
  color: #777777;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.qualification-badge.done {
  background-color: #0A2A1A;
  color: #3DBB8A;
}

.qualification-hint {
  margin-top: 16rpx;
  color: #555555;
  font-size: 22rpx;
  line-height: 1.6;
}

/* 荣誉 */
.honor-input-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.honor-input {
  flex: 1;
  background-color: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 20rpx;
  padding: 0 24rpx;
  height: 84rpx;
  min-height: 84rpx;
  line-height: normal;
  font-size: 26rpx;
  color: #FFFFFF;
}

.honor-add-btn {
  background-color: rgba(204, 136, 0, 0.15);
  border: 1rpx solid #CC8800;
  color: #CC8800;
  font-size: 26rpx;
  font-weight: 500;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.honor-tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.honor-tag-item {
  display: flex;
  align-items: center;
  background-color: rgba(204, 136, 0, 0.1);
  border: 1rpx solid #3A2800;
  border-radius: 40rpx;
  padding: 8rpx 20rpx;
  gap: 10rpx;
}

.honor-tag-text {
  font-size: 24rpx;
  color: #CC8800;
}

.honor-tag-remove {
  font-size: 28rpx;
  color: #555555;
  line-height: 1;
}

.honor-hint {
  font-size: 22rpx;
  color: #444444;
  margin-top: 16rpx;
}

.honor-readonly-card {
  background-color: rgba(204, 136, 0, 0.08);
  border: 1rpx solid rgba(204, 136, 0, 0.24);
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
}

.honor-readonly-title {
  color: #D49A38;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.honor-readonly-desc {
  color: #777777;
  font-size: 23rpx;
  line-height: 1.55;
}

/* ── 段位审核 ── */
.level-review-card {
  background-color: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
}

.level-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.level-label {
  font-size: 24rpx;
  color: #555555;
}

.level-badge {
  font-size: 26rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  background-color: #242424;
  color: #888888;
}

.level-badge.tier-S { background-color: rgba(255,215,0,0.15); color: #FFD700; }
.level-badge.tier-Splus { background-color: rgba(255,215,0,0.2); color: #FFD700; }
.level-badge.tier-A { background-color: rgba(255,107,26,0.15); color: #FF6B1A; }
.level-badge.tier-Aplus { background-color: rgba(255,107,26,0.2); color: #FF6B1A; }
.level-badge.tier-B { background-color: rgba(59,130,246,0.15); color: #3B82F6; }
.level-badge.tier-Bplus { background-color: rgba(59,130,246,0.2); color: #3B82F6; }
.level-badge.tier-C { background-color: rgba(34,197,94,0.15); color: #22C55E; }
.level-badge.tier-Cplus { background-color: rgba(34,197,94,0.2); color: #22C55E; }
.level-badge.tier-D { background-color: rgba(136,136,136,0.15); color: #888888; }
.level-badge.tier-Dplus { background-color: rgba(136,136,136,0.2); color: #AAAAAA; }

.level-status {
  font-size: 24rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.level-status.none {
  color: #666666;
}

.level-status.pending {
  color: #CC8800;
  background-color: rgba(204,136,0,0.1);
}

.level-status.approved {
  color: #3DBB8A;
  background-color: rgba(61,187,138,0.1);
}

.level-status.rejected {
  color: #E53935;
  background-color: rgba(229,57,53,0.1);
}

.level-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #2A2A2A;
  font-size: 26rpx;
  color: #FF6B1A;
  font-weight: 500;
}

.level-action:active {
  opacity: 0.7;
}

.arrow-right {
  font-size: 32rpx;
  color: #555555;
}

/* ── 段位选择弹层 ── */
.level-picker-mask {
  position: fixed;
  inset: 0;
  background-color: rgba(0,0,0,0.6);
  z-index: 100;
}

.level-picker-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #111111;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 101;
  padding-bottom: env(safe-area-inset-bottom);
}

.level-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
  border-bottom: 1rpx solid #1A1A1A;
}

.level-picker-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.level-picker-close {
  font-size: 32rpx;
  color: #555555;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.level-picker-body {
  padding: 24rpx 32rpx 32rpx;
}

.level-picker-hint {
  font-size: 24rpx;
  color: #777777;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.level-tier-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.level-tier-option {
  flex: 0 0 calc(33.33% - 11rpx);
  text-align: center;
  padding: 20rpx 0;
  background-color: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #888888;
}

.level-tier-option.active {
  background-color: rgba(255,107,26,0.15);
  border-color: #FF6B1A;
  color: #FF6B1A;
}

.level-note-label {
  font-size: 24rpx;
  color: #555555;
  margin-bottom: 12rpx;
}

.level-note-input {
  width: 100%;
  min-height: 100rpx;
  background-color: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.level-submit-btn {
  text-align: center;
  padding: 22rpx 0;
  background-color: #FF6B1A;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.level-submit-btn:active {
  opacity: 0.85;
}

.level-proof-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.level-proof-item {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
  background-color: #1A1A1A;
}

.level-proof-img {
  width: 100%;
  height: 100%;
}

.level-proof-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.6);
  border-radius: 0 12rpx 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #FFFFFF;
}

.level-proof-add {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #3A3A3A;
  background-color: #1A1A1A;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.level-proof-plus {
  font-size: 36rpx;
  color: #555555;
  line-height: 1;
}

.level-proof-add-text {
  font-size: 20rpx;
  color: #555555;
}
