page { background: #0F0F0F; }
.container { height: 100vh; padding: 24rpx 28rpx calc(44rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #0F0F0F; }
.section { background: #1A1A1A; border: 1rpx solid #282828; border-radius: 20rpx; padding: 22rpx; margin-bottom: 18rpx; }
.section-title { color: #FFF; font-size: 30rpx; font-weight: 900; margin-bottom: 16rpx; }
.section-sub { color: #777; font-size: 22rpx; line-height: 1.5; margin-top: 12rpx; }
.time-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.time-grid.two { grid-template-columns: 1fr 1fr; }
.input-box, .text-input { height: 76rpx; line-height: 76rpx; border-radius: 14rpx; background: #111; border: 1rpx solid #2A2A2A; color: #FFF; font-size: 25rpx; text-align: center; box-sizing: border-box; padding: 0 14rpx; }
.venue-block { margin-bottom: 12rpx; }
.venue-picker-card { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; border-radius: 16rpx; background: #111; border: 1rpx solid #2A2A2A; padding: 18rpx; margin-bottom: 14rpx; }
.venue-picker-title { color: #FFF; font-size: 26rpx; font-weight: 900; margin-bottom: 6rpx; }
.venue-picker-sub { color: #777; font-size: 22rpx; line-height: 1.45; }
.venue-picker-action { height: 52rpx; line-height: 52rpx; border-radius: 26rpx; background: #FF6B1A; color: #FFF; padding: 0 18rpx; font-size: 23rpx; font-weight: 800; flex-shrink: 0; }
.venue-head { border-radius: 16rpx; background: #111; border: 1rpx solid #2A2A2A; padding: 18rpx; color: #FFF; font-size: 26rpx; font-weight: 800; }
.venue-head.active { border-color: #FF6B1A; background: rgba(255,107,26,0.12); }
.venue-head text { display: block; color: #777; font-size: 22rpx; font-weight: 400; margin-top: 6rpx; }
.court-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10rpx; margin-top: 10rpx; }
.court-chip { border-radius: 14rpx; background: rgba(61,187,138,0.1); border: 1rpx solid rgba(61,187,138,0.32); padding: 16rpx; color: #3DBB8A; font-size: 24rpx; }
.court-chip text { display: block; font-size: 20rpx; margin-top: 4rpx; }
.court-chip.disabled { background: #151515; border-color: #2A2A2A; color: #666; }
.court-chip.active { background: #FF6B1A; border-color: #FF6B1A; color: #FFF; }
.seg-row { display: flex; gap: 10rpx; flex-wrap: wrap; }
.seg { flex: 1; min-width: 140rpx; height: 62rpx; line-height: 62rpx; border-radius: 31rpx; background: #111; border: 1rpx solid #2A2A2A; color: #888; text-align: center; font-size: 24rpx; }
.seg.active { background: #FF6B1A; color: #FFF; border-color: #FF6B1A; }
.textarea { width: 100%; height: 150rpx; border-radius: 16rpx; background: #111; border: 1rpx solid #2A2A2A; color: #FFF; font-size: 25rpx; padding: 18rpx; box-sizing: border-box; margin: 14rpx 0; }
.empty { color: #777; font-size: 24rpx; padding: 24rpx 0; }
.submit-btn { height: 88rpx; line-height: 88rpx; border-radius: 22rpx; background: #FF6B1A; color: #FFF; text-align: center; font-size: 30rpx; font-weight: 900; margin-top: 26rpx; }
